    { "id": 24578, "name": "JoinRace", "channel": 0 },
    { "id": 24579, "name": "LeaveRace", "channel": 0 },
    { "id": 24580, "name": "VehicleInput", "channel": 1 },
    { "id": 24581, "name": "VehicleSnapshot", "channel": 1 },
